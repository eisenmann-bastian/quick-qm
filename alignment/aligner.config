# YAML example for selection/reference_molecules.csv alignment output.
# Filter values are regular expressions; any matching axis row is retained.
rigid:
  - molecule_name: "^241$"
    selector: "^aromatic ring$"
    axis_type: "^aromatic_normal$"
flexible:
  - molecule_name: "^878$"
    selector: "^thiol$"
    axis_type: "^hydrogen_sigma$"
output_format: pair-files
output: aligned_pairs
overwrite_output: false
alignment_mode: default
# Optional fixed center distance in angstroms. If omitted, use van der Waals radii.
# distance: 3.0
#
# For a distance scan, replace alignment_mode above with distance-scan and
# provide the following settings (choose either scan_step or scan_count):
# scan_start: 2.0
# scan_end: 4.0
# include_start: true
# include_end: true
# scan_step: 0.1
# scan_count: 19  # interior points; included boundaries are additional
