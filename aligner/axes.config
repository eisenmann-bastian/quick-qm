# YAML. Directions are numbered per axis name and center, in generation order.
# A missing direction number inherits enabled: true; set enabled: false to disable all.
axes:
  aromatic_ring_normal:
    enabled: true
    directions: {1: true, 2: true}
  carboxylate_bond_extension:
    enabled: true
  carboxylate_lone_pair:
    enabled: true
    directions: {1: true, 2: true}
  chalcogen_bond_extension:
    enabled: true
    directions: {1: true, 2: true}
  chalcogen_lone_pair:
    enabled: true
    directions: {1: true, 2: true}
  halogen_bond_extension:
    enabled: true
  hydrogen_donor_extension:
    enabled: true
  nitrile_nitrogen_extension:
    enabled: true
  ring_nitrogen_lone_pair:
    enabled: true
  imine_nitrogen_lone_pair:
    enabled: true
  thioether_plane_normal:
    enabled: true
    directions: {1: true, 2: true}
  thioether_outward_bisector:
    enabled: true
  thiol_plane_normal:
    enabled: true
    directions: {1: true, 2: true}
  thiol_outward_bisector:
    enabled: true
