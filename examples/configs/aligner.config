# YAML example for examples/reference_molecules.csv alignment output.
# Filter values are regular expressions; any matching axis row is retained.
rigid:
  include:
    - molecule_name: "^241$"
      selector: "^aromatic ring$"
      axis_type: "^aromatic_normal$"
flexible:
  include:
    - molecule_name: "^878$"
      selector: "^thiol$"
      axis_type: "^hydrogen_sigma$"
# Each side may also have an exclude list; omitted or empty lists match all.
output_format: pair-files
output: aligned_pairs
overwrite_output: false
# stable: keep the flexible axis opposite Y; toward-center: point at the rigid center.
flexible_orientation: stable
# Optional rotation about the placed flexible axis:
# torsion_optimization:
#   enabled: true
#   score: minimum_distance  # or average_distance, mmff94_interaction
#   objective: maximize       # or minimize; energy is usually minimized
#   steps_per_iteration: 12
#   iterations: 3
#   include_vdw: false
#   exclude_flexible_site: true
#   exclude_rigid_site: false
#   exclude_flexible_atoms: []  # 0-based SDF atom indices
#   exclude_rigid_atoms: []
# Omit grid_based_scan for the default Y van der Waals distance and zero X/Z.
# Each axis accepts either a fixed distance or a scan range.
# grid_based_scan:
#   y:
#     scan_start: 2.0
#     scan_end: 4.0
#     scan_count: 19  # interior points; included boundaries are additional
#     include_start: true
#     include_end: true
#   x:
#     scan_start: -1.0
#     scan_end: 1.0
#     scan_step: 0.5
#   z:
#     distance: 0.5
# reference_axis:
#   priority: [A, B, C]
#   enabled: {A: true, B: true, C: true}
#
# Alternatively to grid_based_scan, use spherical coordinates:
# polar_coordinate_based_scan:
#   radius: {distance: 3.0}
#   phi: {scan_start: 0, scan_end: 360, scan_step: 90}
#   phi_unit: degrees
#   theta: {scan_start: 0, scan_end: 180, scan_step: 90}
#   theta_unit: degrees
#   merge_tolerance: 0.05
