# YAML example for examples/reference_molecules.csv alignment output.
# Filter values are regular expressions; any matching axis row is retained.
rigid:
  include:
    - molecule_name: "^241$"
      selector: "^aromatic ring$"
      axis_type: "^aromatic_normal$"
flexible:
  include:
    - molecule_name: "^878$"
      selector: "^thiol$"
      axis_type: "^hydrogen_sigma$"
output_format: pair-files
output: aligned_pairs
overwrite_output: true
grid_based_scan:
  y:
    scan_start: 2.0
    scan_end: 4.0
    include_start: true
    include_end: true
    scan_count: 10
